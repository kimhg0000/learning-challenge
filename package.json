{
  "name": "15week-learning-challenge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "rules:emulators": "firebase emulators:start --only firestore,storage,auth",
    "rules:test": "firebase emulators:exec --only firestore,storage,auth \"vitest run --config tests/rules/vitest.rules.config.ts\""
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "idb-keyval": "^6.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.29.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
