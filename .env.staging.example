# Copy to .env.staging and fill in a SEPARATE Firebase project's values —
# never the same project as .env (production). .env.staging is git-ignored.
#
# This file exists so `npm run build:staging` (vite build --mode staging)
# builds against a fully isolated staging Firebase project: separate
# Authentication, separate Firestore, separate Storage, separate Security
# Rules deploy, separate student data. See README.md "Staging environment".

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_PROTOTYPE_MODE=false
VITE_USE_FIREBASE_EMULATOR=false

# Staging-only calendar override (see src/constants.ts). Pick a
# PROGRAM_START a week or two before "now" (not exactly "now") so staging
# has a genuinely expired week to test "지난 주차 차단" against, a genuinely
# current week to test real submissions against immediately, and later weeks
# to test "미래 주차 차단". NEVER set these in .env (production) — production
# always uses the hardcoded defaults in src/constants.ts. Regenerate
# firestore.staging.rules to match if you change these — run
# `node scripts/generate-staging-rules.mjs` after editing (and update the
# constants at the top of that script to match).
VITE_PROGRAM_START=2026-08-17T00:00:00+09:00
VITE_PROGRAM_END=2026-11-29T23:59:59+09:00
VITE_SEMESTER_ID=staging-2026
