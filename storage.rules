rules_version = '2';

// ---------------------------------------------------------------------------
// 15-week learning challenge — Storage security rules.
//
// - submissions/{uid}/weekN.jpg  — private proof photo, owner + instructor only.
// - feedPhotos/{feedId}.jpg      — a second copy uploaded for the anonymous
//                                  feed, named by a random id (never the uid),
//                                  so the public feed never leaks a uid via
//                                  its image URL. See firestore.rules for why
//                                  a feedPosts document (which this photo
//                                  belongs to) can only be created alongside
//                                  a real, already-validated private submission.
//
// Instructor status is decided the same way as in firestore.rules: via a
// cross-service read of instructorAllowlist, never from a client-supplied
// value. This requires Firestore rules to be deployed in the same project.
// ---------------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isInstructor() {
      return isSignedIn() && firestore.exists(
        /databases/(default)/documents/instructorAllowlist/$(request.auth.token.email.lower())
      );
    }

    function isReasonableImage() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /submissions/{uid}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isInstructor());
      allow write: if isSignedIn() && request.auth.uid == uid && isReasonableImage();
      allow delete: if false;
    }

    match /feedPhotos/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isReasonableImage();
      allow delete: if false;
    }

    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
