rules_version = '2';

// ---------------------------------------------------------------------------
// 15-week learning challenge — Storage security rules.
//
// - submissions/{uid}/{semesterId}/weekN.jpg — private proof photo, owner +
//                                  instructor only. Namespaced by semester
//                                  (see firestore.rules currentSemester())
//                                  so a reused account in a later semester
//                                  can never overwrite a past semester's photo.
// - feedPhotos/{feedId}.jpg      — a second copy uploaded for the anonymous
//                                  feed, named by a one-way SHA-256 hash of
//                                  the private submission id (never the raw
//                                  uid), so the public feed never leaks a
//                                  uid via its image URL, while still making
//                                  a retried feed write idempotent. See
//                                  firestore.rules for why a feedPosts
//                                  document (which this photo belongs to)
//                                  can only be created alongside a real,
//                                  already-validated private submission.
//
// Instructor status is decided the same way as in firestore.rules: via a
// cross-service read of instructorAllowlist, never from a client-supplied
// value. This requires Firestore rules to be deployed in the same project.
// ---------------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isInstructor() {
      return isSignedIn() && request.auth.token.email_verified == true && firestore.exists(
        /databases/(default)/documents/instructorAllowlist/$(request.auth.token.email.lower())
      );
    }

    function isReasonableImage() {
      // Kept in lockstep by hand with MAX_IMAGE_BYTES in src/constants.ts —
      // rules cannot import that file. 8MB was too low for a modern phone's
      // default camera resolution; 20MB covers that with headroom.
      return request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /submissions/{uid}/{semesterId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isInstructor());
      allow write: if isSignedIn() && request.auth.uid == uid
        && resource == null && request.resource != null && isReasonableImage();
      allow delete: if false;
    }

    match /feedPhotos/{fileName} {
      allow read: if isSignedIn();
      allow write: if false; // Server Admin SDK publishes thumbnails; clients never write.
      allow delete: if false;
    }

    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
