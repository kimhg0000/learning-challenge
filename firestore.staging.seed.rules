rules_version = '2';

// ---------------------------------------------------------------------------
// 15-week learning challenge — Firestore security rules.
//
// *** STAGING VARIANT — generated by scripts/generate-staging-rules.mjs ***
// Identical to firestore.rules in every way EXCEPT currentSemester() and
// programStart(). Deployed ONLY to the staging Firebase project
// (learning-challenge-staging), never to production. Do not hand-edit —
// re-run the generator instead, so it can never silently drift from the
// real, audited production rules.
//
// Authorization model:
//   - A student can only ever read/write their OWN users/{uid} doc,
//     goalVersions subcollection, and submissions.
//   - "Instructor" is never trusted from a client-writable field. It is
//     decided here, server-side, by checking whether the caller's verified
//     auth token email has a document in `instructorAllowlist`. That
//     collection is NOT writable by any client role defined below — the
//     course owner adds/removes instructors by hand in the Firebase
//     Console. This is the whole point: a student editing devtools/network
//     requests cannot grant themselves the instructor role.
//   - Anonymous feed posts (`feedPosts`) intentionally carry no uid/email/
//     name/studentId field at all, and are validated to only ever be
//     created alongside a real private submission the same student already
//     owns — see isLinkedToOwnSubmission().
//
// Program calendar: PROGRAM_START and SEMESTER_ID below MUST match
// src/constants.ts (PROGRAM_START = 2026-09-07T00:00:00+09:00, i.e.
// 2026-09-06T15:00:00Z; SEMESTER_ID = '2026-fall'). If you reuse this app
// for a different semester, update BOTH this file, storage.rules, and
// src/constants.ts together — a mismatched SEMESTER_ID here would reject
// every real write from the deployed app.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    function isInstructor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/instructorAllowlist/$(callerEmail()));
    }

    function currentSemester() {
      return 'staging-2026'; // STAGING override — see scripts/generate-staging-rules.mjs
    }

    // 2026-09-06T15:00:00Z == 2026-09-07T00:00:00+09:00 (Monday, week 1, KST)
    // 2026-08-16T15:00:00.000Z == 2026-08-17T00:00:00+09:00 (Monday, staging week 1, KST) — STAGING override
    function programStart() {
      return timestamp.date(2026, 8, 16) + duration.value(15, 'h');
    }

    function weekStart(week) {
      return programStart() + duration.value((week - 1) * 7 * 24, 'h');
    }

    // Exclusive upper bound = next Monday 00:00 KST (i.e. through Sunday 23:59:59.999 KST)
    function weekEnd(week) {
      return weekStart(week) + duration.value(7 * 24, 'h');
    }

    function isValidWeekNumber(week) {
      return week is int && week >= 1 && week <= 15;
    }

    function isWithinWeekWindow(week) { return isValidWeekNumber(week); } // *** SEED-ONLY override — see scripts/generate-staging-seed-rules.mjs. NEVER leave this deployed; restore firestore.staging.rules immediately after seeding. ***

    function isValidGoalFields(d) {
      return d.goalText is string && d.goalText.size() >= 10 && d.goalText.size() <= 180
        && d.weekday is int && d.weekday >= 0 && d.weekday <= 6
        && d.startTime is string && d.startTime.matches('^[0-2][0-9]:[0-5][0-9]$')
        && d.duration is int && d.duration > 0 && d.duration <= 120;
    }

    // Students must have a real 7-digit student id; instructor accounts have
    // no student id at all (ensureInstructorProfile always writes ''), so the
    // 7-digit format is only enforced for role:'student' — requiring it
    // unconditionally would make it impossible to ever create ANY instructor
    // profile document, since '' can never match ^[0-9]{7}$.
    function isValidStudentIdForRole(role, studentId) {
      return studentId is string
        && (role == 'instructor' ? studentId == '' : studentId.matches('^[0-9]{7}$'));
    }

    // ------------------------------------------------------------------
    // config / instructorAllowlist — server-controlled instructor role.
    // No client write path exists for either collection on purpose.
    // ------------------------------------------------------------------
    match /instructorAllowlist/{email} {
      // A signed-in user may only check membership for THEIR OWN email
      // (so students can't enumerate the instructor list), the admin
      // dashboard's isInstructor() check still works via exists() above
      // regardless of this read rule.
      allow get: if isSignedIn() && callerEmail() == email;
      allow list: if false;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // users/{uid}
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isInstructor());
      allow list: if isSignedIn() && isInstructor();

      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 2
        && isValidStudentIdForRole(request.resource.data.role, request.resource.data.studentId)
        && request.resource.data.characterType in ['rabbit', 'fox', 'otter', 'panda']
        && request.resource.data.semesterId == currentSemester()
        && request.resource.data.currentGoalVersion == 1
        && isValidGoalFields(request.resource.data)
        && (
          (request.resource.data.role == 'student')
          || (request.resource.data.role == 'instructor' && isInstructor())
        );

      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.characterType == resource.data.characterType // permanent, per character-account binding rule
        && request.resource.data.role == resource.data.role
        && request.resource.data.semesterId == resource.data.semesterId // the roster a student belongs to never changes after signup
        && isValidStudentIdForRole(request.resource.data.role, request.resource.data.studentId)
        && request.resource.data.name is string && request.resource.data.name.size() >= 2
        && isValidGoalFields(request.resource.data)
        && request.resource.data.currentGoalVersion >= resource.data.currentGoalVersion
        && request.resource.data.currentGoalVersion <= resource.data.currentGoalVersion + 1;

      allow delete: if false;

      match /goalVersions/{versionId} {
        allow get: if isSignedIn() && (request.auth.uid == uid || isInstructor());
        allow list: if isSignedIn() && (request.auth.uid == uid || isInstructor());

        // 'initial' (version 1) is created in the SAME batch as the parent
        // users/{uid} document itself (see FirebaseBackend.completeOnboarding).
        // get() inside a security rule always sees the database as it was
        // BEFORE the whole batch/transaction commits — so for this doc alone,
        // the parent users/{uid} doc it would cross-check against does not
        // exist yet from the rule engine's point of view, even though it is
        // being created in the same batch. Version 1 is therefore validated
        // as a fixed literal instead of via the cross-document sequence
        // check; every later edit (version 2+) still requires it.
        allow create: if isSignedIn() && request.auth.uid == uid
          && isValidGoalFields(request.resource.data)
          && request.resource.data.changedAt == request.time
          && request.resource.data.changeType in ['initial', 'edit']
          && request.resource.data.version is int
          && versionId == string(request.resource.data.version)
          && (
            (request.resource.data.changeType == 'initial' && request.resource.data.version == 1)
            || (request.resource.data.changeType == 'edit'
                && request.resource.data.version == get(/databases/$(database)/documents/users/$(uid)).data.currentGoalVersion + 1)
          );

        allow update, delete: if false;
      }

      // Append-only audit trail of name/studentId corrections — a student's
      // OWN edit, made through FirebaseBackend.updateProfile() in the same
      // batch as the users/{uid} update itself. Never touches goal/
      // submission data. Instructors can read it so a real-name change is
      // visible in the student-history modal instead of silently rewriting
      // history.
      match /profileHistory/{entryId} {
        allow get, list: if isSignedIn() && (request.auth.uid == uid || isInstructor());
        allow create: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['previousName', 'newName', 'previousStudentId', 'newStudentId', 'changedAt'])
          && request.resource.data.changedAt == request.time;
        allow update, delete: if false;
      }

      // Single doc ('record') holding a student's current privacy-policy
      // consent. Overwritten (not versioned/appended) when a student
      // re-consents to a newer PRIVACY_POLICY_VERSION (see
      // src/config/privacy.ts and src/utils/privacyConsent.ts) — this app
      // deliberately keeps only "current consent status", not a full consent
      // history. agreedAt must equal request.time so a student can never
      // backdate/forward-date their own consent record from devtools, and
      // only the student themselves may ever write it — instructors get
      // read-only visibility (student-history modal) and can never consent
      // on a student's behalf.
      match /privacyConsent/{docId} {
        allow get, list: if isSignedIn() && (request.auth.uid == uid || isInstructor());
        allow create, update: if isSignedIn() && request.auth.uid == uid
          && docId == 'record'
          && request.resource.data.keys().hasOnly(['agreed', 'version', 'agreedAt', 'source'])
          && request.resource.data.agreed == true
          && request.resource.data.version is string && request.resource.data.version.size() > 0
          && request.resource.data.agreedAt == request.time
          && request.resource.data.source in ['signup', 'existing-user'];
        allow delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // studentIdRegistry/{semesterId}_{studentId} — a lightweight claim-check
    // so two students in the same semester can't end up with the same
    // student id (by accident at signup, or by editing into a collision
    // later). Firestore's own create-vs-update classification does the
    // actual enforcement: this collection only ever allows `create`, never
    // `update`, so a create() attempt against an id that's already claimed
    // is evaluated as an update and is denied by the absence of any allow
    // update rule — no cross-document exists() check is needed (and a
    // same-batch exists() check wouldn't see this doc's own creation
    // anyway). A student's OWN id is intentionally never released once
    // claimed, even if they later change it, since re-issuing a retired id
    // to someone else risks exactly the confusion this exists to prevent.
    // ------------------------------------------------------------------
    match /studentIdRegistry/{regId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'studentId', 'semesterId'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.semesterId == currentSemester()
        && request.resource.data.studentId.matches('^[0-9]{7}$')
        && regId == request.resource.data.semesterId + '_' + request.resource.data.studentId;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // submissions/{uid}_{semesterId}_w{week} — private, immutable, one per
    // student/semester/week. Namespacing the id by semester means a student
    // account reused in a later semester can never collide with (or be
    // blocked by) their own submission from a past semester.
    // ------------------------------------------------------------------
    match /submissions/{subId} {
      // Ownership is derived from the deterministic doc id itself
      // (uid + '_' + ...), NOT resource.data.userId — because
      // FirebaseBackend.getMySubmissions() checks all 15 possible week ids
      // directly (see the comment there for why list can't be used for
      // this), most of which don't exist for any given student. resource is
      // null for a non-existent doc, so resource.data.userId would throw
      // rather than just evaluate to false; matching the id prefix instead
      // works identically whether or not the document exists.
      allow get: if isSignedIn() && (isInstructor() || subId.matches(request.auth.uid + '_.*'));
      allow list: if isSignedIn() && isInstructor(); // students fetch their own via 15 direct get()s, never a bare list of everyone's

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.semesterId == currentSemester()
        && subId == request.auth.uid + '_' + currentSemester() + '_w' + string(request.resource.data.week)
        && !exists(/databases/$(database)/documents/submissions/$(subId))
        && isWithinWeekWindow(request.resource.data.week)
        && request.resource.data.reflection is string && request.resource.data.reflection.size() >= 10
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() > 0
        && request.resource.data.serverCreatedAt == request.time
        && request.resource.data.goalSnapshot.version == request.resource.data.goalVersion
        && isValidGoalFields(request.resource.data.goalSnapshot);

      allow update, delete: if false; // audit trail: a submission, once recorded, cannot be altered by anyone
    }

    // ------------------------------------------------------------------
    // feedPosts/{feedId} — fully anonymous, no uid/email/name/studentId.
    // ------------------------------------------------------------------
    match /feedPosts/{feedId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ['anonName', 'semesterId', 'week', 'reflection', 'photoURL', 'characterType', 'characterStage', 'punctualClaim', 'createdAt']
           )
        && request.resource.data.anonName is string
        && request.resource.data.semesterId == currentSemester()
        && isValidWeekNumber(request.resource.data.week)
        && request.resource.data.reflection is string
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() > 0
        && request.resource.data.createdAt == request.time
        // Only allowed alongside a private submission this same student already owns for this week —
        // ties the anonymous post to a real, already-validated submission without ever storing the uid.
        && exists(/databases/$(database)/documents/submissions/$(request.auth.uid + '_' + currentSemester() + '_w' + string(request.resource.data.week)))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.anonName == request.resource.data.anonName;

      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // adminAuditLogs/{logId} — written ONLY by the deleteStudentAccount
    // Cloud Function via the Admin SDK (which bypasses these rules
    // entirely), never by any client. Readable by instructors for
    // transparency into what was deleted and by whom; contains no
    // reflection/photo content, only identifying fields — see
    // functions/src/index.ts.
    // ------------------------------------------------------------------
    match /adminAuditLogs/{logId} {
      allow get, list: if isInstructor();
      allow write: if false;
    }
  }
}
