# Copy this file to .env and fill in your own Firebase project's values.
# .env is git-ignored — never commit real values.
#
# Where to get these: Firebase Console → Project settings → General →
# "Your apps" → Web app → SDK setup and configuration → Config.
# These values are safe to ship in a client bundle (they identify the
# project, not a secret key) — real access control lives in
# firestore.rules / storage.rules, not in these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true"  = prototype/demo mode: local-only fake backend (IndexedDB), the
#           "체험하기" buttons, test-week picker and test-photo generator
#           are all shown, and the real weekly date lock is bypassed.
# "false" = production mode: real Firebase backend only, demo/testing UI
#           is not shown, real Monday-Sunday submission windows enforced.
VITE_PROTOTYPE_MODE=true

# Dev-only: when VITE_PROTOTYPE_MODE=false, set this to "true" to run the
# REAL FirebaseBackend against a local `npm run rules:emulators` instead of a
# real Firebase project — no Firebase project needed to test the real,
# rules-enforced flow end to end on localhost. Leave unset/false otherwise;
# never set this in a real deploy.
VITE_USE_FIREBASE_EMULATOR=false

# NOTE: the instructor allowlist is NOT an env var / code value on purpose
# (a client-side list can be edited by anyone with devtools). It lives in
# Firestore as one document per instructor email at
# instructorAllowlist/<lowercase email> and must be created by hand in the
# Firebase Console after you set up the project — see README.md
# "Instructor setup".
